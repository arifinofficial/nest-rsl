    "rxjs": ">=7",
    "typeorm": ">=0.3"
  },
  "devDependencies": {
    "@automapper/classes": "^9.0.2",
    "@automapper/core": "^9.0.2",
    "@automapper/nestjs": "^9.0.2",
    "@nestjs/common": "^12.5.1",
    "@nestjs/core": "^12.5.1",
    "@nestjs/testing": "^12.5.1",
    "@types/node": "^22.10.7",
    "@types/sql.js": "^1.4.11",
